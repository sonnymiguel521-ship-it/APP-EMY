# Inventario Tienda de Ropa — contrato de variables de entorno.
# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.

# Neon, rama `main` (desarrollo). Usa la cadena del POOLER, no la del host directo.
DATABASE_URL=

# Neon, rama `test`. Debe ser distinta de DATABASE_URL: tests/setup.ts aborta si coinciden.
TEST_DATABASE_URL=

# Firma de sesiones. Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origen válido para better-auth. Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# URL pública de la aplicación. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Credenciales del único usuario, creadas por `pnpm db:seed`.
# Cambiar OWNER_PASSWORD y volver a ejecutar la semilla es el procedimiento de recuperación.
OWNER_EMAIL=
OWNER_PASSWORD=

# Fragmento de la cadena de producción que scripts/reset-db.ts se niega a truncar.
PROD_DB_GUARD=

# Solo para el paso de despliegue. Vercel -> Account Settings -> Tokens.
VERCEL_TOKEN=
